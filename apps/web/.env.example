# Fastify API base URL the BFF proxies to (apps/api). Local: http://localhost:3000
API_URL="http://localhost:3000"

# Kinde auth (App Router SDK). Local web runs on :3001; dashboard is at "/".
KINDE_CLIENT_ID="your-client-id"
KINDE_CLIENT_SECRET="your-client-secret"        # secret — never commit a real value
KINDE_ISSUER_URL="https://your-business.kinde.com"
KINDE_SITE_URL="http://localhost:3001"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3001"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3001/"
KINDE_AUDIENCE="https://your-api-url"           # scopes the access token to the API
