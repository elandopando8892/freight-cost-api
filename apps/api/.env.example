DATABASE_URL="postgresql://user:password@localhost:5432/freight_cost"
# Vercel Preview only. The runtime requires this isolated Neon URL whenever
# VERCEL_ENV=preview and never falls back to DATABASE_URL in that environment.
STAGING_DATABASE_URL=""
PORT=3000
NODE_ENV=development
# Producción: SHA del commit desplegado; en Vercel puede tomar VERCEL_GIT_COMMIT_SHA.
RELEASE_SHA="local"
LOG_LEVEL="info"
# Límite por instancia; el WAF de Vercel debe proteger el límite distribuido.
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW="1 minute"
# Producción: https://freight-cost-web.vercel.app (separar múltiples con coma).
CORS_ORIGINS=""

# Supabase Auth — the API verifies access tokens against this project's JWKS.
SUPABASE_URL="https://alqjqzqagdmcywpjtnnr.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
SUPABASE_EXPECTED_PROJECT_REF="alqjqzqagdmcywpjtnnr"
SUPABASE_JWT_AUDIENCE="authenticated"
# Server-only pilot access policy, required by production builds/runtime.
# Configure FCM_AUTH_ACCESS_SCOPE as version:1 JSON with exactly the approved
# sales@heymarksman.com and jgonzalez@xbfreight.com email/subject pairs.
# Subjects must be verified real Supabase UUIDs, never synthetic test values.
# No roles, tenant selection or account creation is granted by this policy.
# FCM_AUTH_SCOPE_REQUIRED=true also requires it outside Vercel production.


OPENAI_API_KEY=""
# Set only after rotating the deployment key, e.g. 2026-08-11T18:00:00Z.
OPENAI_KEY_ROTATED_AT=""
# Required in a release; choose and approve the model explicitly per environment.
OPENAI_MODEL=""
