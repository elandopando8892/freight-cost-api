{
  "name": "freight-cost-api",
  "version": "0.1.0",
  "description": "Freight Cost Model — Backend API for carriers",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:sync-catalog": "tsx prisma/seed/sync-parameter-catalog.ts",
    "db:seed:refs": "tsx prisma/seed/run-reference.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "preflight:release": "tsx scripts/release-preflight.ts",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vercel-build": "tsx scripts/vercel-build.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "envalid": "^8.0.0",
    "fastify": "^5.11.3",
    "jose": "^4.15.9",
    "openai": "^4.104.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "prisma": "^5.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
