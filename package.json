{
  "name": "freight-cost-model",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.1",
  "description": "Freight Cost Model — carrier SaaS monorepo (Fastify API + Next.js web)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "audit:production": "npm audit --omit=dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "secrets:scan": "tsx apps/api/scripts/verify-tracked-secrets.ts",
    "verify:evidence-checkout": "node tools/evidence-package/check-checkout.mjs",
    "verify:planning-arithmetic": "node docs/reviews/r2-economic-review.mjs --check",
    "test:evidence-package": "node --test tools/evidence-package/archive.test.mjs tools/evidence-package/files.test.mjs tools/evidence-package/package.test.mjs",
    "migrations:verify": "tsx apps/api/scripts/verify-migration-artifacts.ts",
    "migrations:contract": "tsx apps/api/scripts/verify-pilot-verification-migration.ts",
    "migrations:go-approval-contract": "tsx apps/api/scripts/verify-pilot-go-approval-migration.ts",
    "migrations:invitation-contract": "tsx apps/api/scripts/verify-organization-invitation-migration.ts",
    "migrations:member-role-contract": "tsx apps/api/scripts/verify-organization-member-role-migration.ts",
    "migrations:supabase-auth-contract": "tsx apps/api/scripts/verify-supabase-identity-cutover-migration.ts",
    "verify:oauth-preview": "tsx apps/api/scripts/verify-oauth-preview-coverage.ts",
    "verify:preview-revisions": "tsx apps/api/scripts/verify-preview-revisions.ts",
    "security:headers": "tsx apps/api/scripts/verify-web-security-headers.ts",
    "smoke:staging:auth": "tsx apps/api/scripts/staging-auth-bff-smoke.ts",
    "e2e:staging:pilot": "tsx apps/api/scripts/staging-pilot-go-e2e.ts",
    "preflight:staging:infra": "tsx apps/api/scripts/staging-infrastructure-preflight.ts",
    "progress:release": "tsx apps/api/scripts/release-progress.ts",
    "db:migrate:staging": "tsx apps/api/scripts/migrate-staging.ts",
    "db:seed:staging": "tsx apps/api/scripts/seed-staging.ts",
    "verify:ci": "npm run verify:evidence-checkout && npm run secrets:scan && npm run test:evidence-package && npm run lint && npm run test && npm run typecheck && npm run db:validate -w freight-cost-api && npm run migrations:verify && npm run migrations:contract && npm run migrations:go-approval-contract && npm run migrations:invitation-contract && npm run migrations:member-role-contract && npm run migrations:supabase-auth-contract && npm run security:headers && npm run build && npm run audit:production && git diff --check && git diff --cached --check",
    "verify:release": "npm run verify:ci && npm run preflight:release -w freight-cost-api",
    "verify:release:rateware": "npm run verify:ci && npm run preflight:release -w freight-cost-api -- --require-rateware",
    "dev:api": "npm run dev -w freight-cost-api",
    "dev:web": "npm run dev -w freight-cost-web"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "zod": "^3.23.8"
  }
}
