{
  "name": "freight-cost-model",
  "private": true,
  "version": "0.1.0",
  "description": "Freight Cost Model — carrier SaaS monorepo (Fastify API + Next.js web)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:api": "npm run dev -w freight-cost-api",
    "dev:web": "npm run dev -w freight-cost-web"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "^3.23.8"
  }
}
